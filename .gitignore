# Unprivileged build toolchain (downloaded, never committed)
.toolchain/

# Python
.venv/
__pycache__/
*.py[co]
.pytest_cache/
*.egg-info/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/**/build/**/*.apk
*.aab

# Desktop build output
desktop/build/
build/

# Runtime state / logs (never trust paths from another machine)
*.log
.state/
/tmp/

# Local env with secrets
.env
.env.*
!.env.example
