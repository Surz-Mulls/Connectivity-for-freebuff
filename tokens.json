{
  "$schema": "continuity-design-tokens/1",
  "name": "Continuity",
  "description": "Canonical design tokens. Generate Compose (Color.kt/Type.kt/Dimens.kt) and QML (Theme.qml singleton) from this file; do not hand-edit generated files.",
  "default_theme": "mocha",
  "themes": {
    "mocha": {
      "base": "#1e1e2e", "mantle": "#181825", "crust": "#11111b",
      "surface0": "#313244", "surface1": "#45475a", "surface2": "#585b70",
      "overlay0": "#6c7086", "text": "#cdd6f4", "subtext": "#a6adc8",
      "accent": "#89b4fa", "accentOn": "#11111b",
      "ok": "#a6e3a1", "warn": "#f9e2af", "error": "#f38ba8", "info": "#74c7ec",
      "privacy": "#cba6f7"
    },
    "latte": {
      "base": "#eff1f5", "mantle": "#e6e9ef", "crust": "#dce0e8",
      "surface0": "#ccd0da", "surface1": "#bcc0cc", "surface2": "#acb0be",
      "overlay0": "#9ca0b0", "text": "#4c4f69", "subtext": "#6c6f85",
      "accent": "#1e66f5", "accentOn": "#eff1f5",
      "ok": "#40a02b", "warn": "#df8e1d", "error": "#d20f39", "info": "#209fb5",
      "privacy": "#8839ef"
    }
  },
  "state_colors": {
    "connected": "ok", "reconnecting": "warn", "discovering": "info",
    "unavailable": "overlay0", "permission_required": "warn", "error": "error",
    "privacy_mode": "privacy", "camera_mic_active": "error"
  },
  "radius": { "sm": 6, "md": 12, "lg": 20, "pill": 999 },
  "spacing": [0, 4, 8, 12, 16, 24, 32, 48],
  "control": { "min_touch_dp": 48, "min_pointer_px": 32 },
  "type": {
    "family_ui": "Inter, 'Noto Sans', system-ui, sans-serif",
    "family_mono": "'JetBrains Mono', 'Noto Sans Mono', monospace",
    "scale_sp": { "caption": 12, "body": 14, "title": 18, "headline": 24 }
  },
  "motion": { "fast_ms": 120, "base_ms": 200, "reduce_motion_respected": true },
  "rules": [
    "Dynamic Material You colors are OFF by default (identity comes from these tokens).",
    "Status color must never be the only signal: pair with an icon and a text label.",
    "Camera/mic/screen/desktop-control active state always uses state_colors.camera_mic_active plus a persistent indicator."
  ]
}
