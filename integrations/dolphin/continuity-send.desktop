[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/all;
Actions=sendToPhone;
X-KDE-Priority=TopLevel
Icon=phone
X-KDE-Submenu=Continuity

[Desktop Action sendToPhone]
Name=Send to phone
Icon=phone
# install.sh rewrites @HELPER@ to the absolute helper path. No shell, no quoting hazard: the files
# are handed to the script as separate arguments, never interpolated into a command string.
Exec=@HELPER@ %F
