# Maintainer-facing Arch package definition.
#
# This is the only definition that produces a real pacman package. Build it with
# `makepkg -sfC` (or scripts/build-arch-distrobox.sh). The file
# dist/continuity-linux-x86_64.pkg.tar.zst written by scripts/package-linux.sh is a
# manually assembled layout archive: it has no .BUILDINFO/.MTREE and must not be
# described as a makepkg package.
#
# Source is the immutable v0.1.0-test.2 tag archive (tag target 8db808a7). The
# checksum below was measured twice from that URL on 2026-11-08 and both downloads
# matched. Do not use SKIP.
pkgname=continuity
pkgver=0.1.0.test2
pkgrel=1
pkgdesc="Local-first Android/Linux continuity: pinned pairing, clipboard, files, notifications"
arch=('x86_64')
url="https://github.com/Surz-Mulls/Connectivity-for-freebuff"
license=('GPL-3.0-only')
depends=('python' 'python-cryptography' 'python-zeroconf' 'python-qrcode' 'python-dbus-next'
         'qt6-declarative')
optdepends=('python-pyside6: alternative QML runtime instead of qt6-declarative')
source=("v0.1.0-test.2.tar.gz::https://github.com/Surz-Mulls/Connectivity-for-freebuff/archive/refs/tags/v0.1.0-test.2.tar.gz")
sha256sums=('aa817ab138cca16efecb15f59def0cfe59845fad852c0e989b015f69ed1e3698')

package() {
  local src="$srcdir/Connectivity-for-freebuff-0.1.0-test.2"
  install -dm0755 "$pkgdir/usr/lib/continuity" "$pkgdir/usr/bin" \
                   "$pkgdir/usr/share/applications" "$pkgdir/usr/share/licenses/continuity" \
                   "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  cp -r "$src/daemon/continuityd" "$pkgdir/usr/lib/continuity/"
  cp -r "$src/desktop/qml" "$pkgdir/usr/lib/continuity/"
  install -Dm0755 "$src/desktop/run-continuity.sh" "$pkgdir/usr/lib/continuity/run-continuity.sh"
  install -Dm0755 "$src/desktop/qml_launcher.py" "$pkgdir/usr/lib/continuity/qml_launcher.py"

  cat > "$pkgdir/usr/bin/continuityd" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
export PYTHONPATH="/usr/lib/continuity${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c 'import sys; from continuityd.cli import main; sys.exit(main())' "$@"
SH
  chmod 0755 "$pkgdir/usr/bin/continuityd"
  cp "$pkgdir/usr/bin/continuityd" "$pkgdir/usr/bin/continuityctl"

  cat > "$pkgdir/usr/bin/continuity" <<'SH'
#!/usr/bin/env bash
exec /usr/lib/continuity/run-continuity.sh "$@"
SH
  chmod 0755 "$pkgdir/usr/bin/continuity"

  install -Dm0644 "$src/LICENSE" "$pkgdir/usr/share/licenses/continuity/LICENSE"
  install -Dm0644 "$src/packaging/continuity.desktop" \
    "$pkgdir/usr/share/applications/continuity.desktop"
  install -Dm0644 "$src/packaging/continuity.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/continuity.svg"
}
